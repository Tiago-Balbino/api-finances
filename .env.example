POSTGRES_PASSWORD=troque-esta-senha-no-servidor
APP_TIMEZONE=America/Araguaina
COOKIE_SECURE=false
# Configure CRON_SECRET no projeto da API na Vercel para autorizar os rendimentos automáticos.
# O cron roda às 11:00 UTC, equivalente a 08:00 em America/Sao_Paulo.
# CRON_SECRET=gere-um-segredo-aleatorio-com-ao-menos-16-caracteres

# Execução sem Docker no banco local antigo:
# PGHOST=/caminho/absoluto/api-finances/.pgsocket
# PGPORT=55432
# PGDATABASE=finances
# Alternativa: DATABASE_URL=postgresql://usuario:senha@host:5432/finances

# Supabase (Vercel): use o Transaction pooler (porta 6543) em DATABASE_URL
# DATABASE_URL=postgresql://postgres.<ref>:<senha>@aws-1-sa-east-1.pooler.supabase.com:6543/postgres?sslmode=require

# Domínios do front que chamam esta API via rewrite (separados por vírgula)
# ALLOWED_ORIGINS=https://seu-front.vercel.app
